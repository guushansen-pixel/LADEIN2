# Vokabeldaten aus AGITE plus (Westermann Bildungsmedien / Schoeningh).
# Gescannt aus dem eigenen Buch - privat damit lernen ist ok, die Liste
# weiterzugeben nicht. Deshalb bleiben Rohscans, das geprueftes Zwischen-TSV
# und das Generat aus dem Repo.
# Neu erzeugen: tools\split-scans.ps1 und danach tools\build-vocab.ps1
source-scans/
vocab-src/
web/data/vocab.agp*.js

# Fertige APKs liegen bewusst nur als jeweils neueste Fassung in dist/,
# sonst waechst das Repo bei jedem Release um ihre volle Groesse.
dist/*.apk
